 {
  "name": "gitea__commit_read",
  "description": "Read commits with optional diff, combined statuses, and compare refs.",
  "parameters": {
   "properties": {
    "base": {
     "description": "branch, tag or SHA, required for 'compare'",
     "type": "string"
    },
    "head": {
     "description": "branch, tag or SHA, required for 'compare'",
     "type": "string"
    },
    "include_diff": {
     "description": "include unified diff for 'get'",
     "type": "boolean"
    },
    "method": {
     "enum": [
      "list",
      "get",
      "get_status",
      "compare"
     ],
     "type": "string"
    },
    "owner": {
     "type": "string"
    },
    "page": {
     "type": "number"
    },
    "path": {
     "description": "only commits touching this path for 'list'",
     "type": "string"
    },
    "per_page": {
     "type": "number"
    },
    "ref": {
     "description": "SHA, branch or tag, required for 'get_status'",
     "type": "string"
    },
    "repo": {
     "type": "string"
    },
    "sha": {
     "description": "required for 'get', optional starting SHA or branch for 'list'",
     "type": "string"
    },
    "wait_seconds": {
     "description": "for 'get_status': seconds to wait while pending, max 45",
     "type": "number"
    }
   },
   "required": [
    "method",
    "owner",
    "repo"
   ],
   "type": "object"
  }
 },
 {
  "name": "gitea__create_or_update_file",
  "description": "Create, update, rename or delete files in one commit.",
  "parameters": {
   "properties": {
    "branch_name": {
     "description": "branch to commit to",
     "type": "string"
    },
    "content": {
     "description": "literal file text, not base64",
     "type": "string"
    },
    "edits": {
     "items": {
      "properties": {
       "new_string": {
        "type": "string"
       },
       "old_string": {
        "type": "string"
       },
       "replace_all": {
        "type": "boolean"
       }
      },
      "required": [
       "old_string",
       "new_string"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "files": {
     "items": {
      "properties": {
       "content": {
        "description": "literal file text, not base64",
        "type": "string"
       },
       "delete": {
        "type": "boolean"
       },
       "edits": {
        "items": {
         "properties": {
          "new_string": {
           "type": "string"
          },
          "old_string": {
           "type": "string"
          },
          "replace_all": {
           "type": "boolean"
          }
         },
         "required": [
          "old_string",
          "new_string"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "from_path": {
        "description": "rename source",
        "type": "string"
       },
       "path": {
        "description": "path relative to repo root",
        "type": "string"
       },
       "sha": {
        "description": "existing file SHA, of from_path when renaming (omit to create)",
        "type": "string"
       }
      },
      "required": [
       "path"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "message": {
     "description": "commit message",
     "type": "string"
    },
    "new_branch_name": {
     "description": "branch to create from branch_name and commit to",
     "type": "string"
    },
    "owner": {
     "type": "string"
    },
    "path": {
     "description": "path relative to repo root",
     "type": "string"
    },
    "repo": {
     "type": "string"
    },
    "sha": {
     "description": "existing file SHA (omit to create)",
     "type": "string"
    }
   },
   "required": [
    "owner",
    "repo",
    "message",
    "branch_name"
   ],
   "type": "object"
  }
 },
