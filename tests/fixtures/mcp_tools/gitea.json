     ],
     "type": "string"
    },
    "org": {
     "description": "for \"list_org_repos\"",
     "type": "string"
    },
    "owner": {
     "description": "required except list_my_repos/list_org_repos",
     "type": "string"
    },
    "page": {
     "type": "number"
    },
    "per_page": {
     "type": "number"
    },
    "repo": {
     "description": "required for get and branch protections",
     "type": "string"
    },
    "rule_name": {
     "description": "required for get_branch_protection",
     "type": "string"
    }
   },
   "required": [
    "method"
   ],
   "type": "object"
  }
 },
