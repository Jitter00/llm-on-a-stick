{
  "$defs": {
    "CheckResult": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "title": "Weight",
          "type": "number"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "observed": {
          "default": null,
          "title": "Observed"
        },
        "hints": {
          "items": {
            "enum": [
              "no-output",
              "truncated-output",
              "hallucinated-value",
              "wrong-format",
              "unfiltered-output",
              "incomplete-config",
              "wrong-config",
              "collateral-change",
              "missing-object",
              "env-error",
              "max-turns",
              "timeout",
              "model-error",
              "refusal",
              "tool-call-error",
              "no-tool-use",
              "output-limit",
              "repetition-loop",
              "empty-reply",
              "context-full",
              "answer-in-reply",
              "wrong-dialect",
              "attempted-change",
              "no-verification",
              "ignored-error"
            ],
            "type": "string"
          },
          "title": "Hints",
          "type": "array"
        }
      },
      "required": [
        "name",
        "type",
        "status"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "JudgeCheck": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "default": "not-graded",
          "enum": [
            "graded",
            "not-graded",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "artifact": {
          "default": "transcript",
          "title": "Artifact",
          "type": "string"
        },
        "scale": {
          "default": 5,
          "title": "Scale",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The median of `scores`.",
          "title": "Score"
        },
        "scores": {
          "description": "One per repeat of the judgement.",
          "items": {
            "type": "integer"
          },
          "title": "Scores",
          "type": "array"
        },
        "agreement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of the repeats that gave the most common score (1.0: all agreed).",
          "title": "Agreement"
        },
        "reason": {
          "default": "",
          "description": "The judge's reason, or why the check was not graded.",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "JudgeCheck",
      "type": "object"
    },
    "Judgement": {
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The judge, provider/model. None: no judge has run.",
          "title": "Model"
        },
        "sampling": {
          "additionalProperties": true,
          "description": "Sampling settings sent to the judge.",
          "title": "Sampling",
          "type": "object"
        },
        "repeats": {
          "default": 0,
          "title": "Repeats",
          "type": "integer"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/JudgeCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean of the graded checks, each put on 0..1. Not part of `score`.",
          "title": "Score"
        },
        "summary": {
          "default": "",
          "description": "Why the attempt did not pass, in plain language. Not scored; empty on a pass.",
          "title": "Summary",
          "type": "string"
        },
        "tokens_in": {
          "default": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "judged_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judged At"
        }
      },
      "title": "Judgement",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "stick_version": {
      "title": "Stick Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "graded_at": {
      "format": "date-time",
      "title": "Graded At",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "pass",
        "partial",
        "fail",
        "error"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "score": {
      "description": "Weighted share of checks that passed (errors excluded).",
      "maximum": 1,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "failure_hints": {
      "description": "Union of all check hints.",
      "items": {
        "enum": [
          "no-output",
          "truncated-output",
          "hallucinated-value",
          "wrong-format",
          "unfiltered-output",
          "incomplete-config",
          "wrong-config",
          "collateral-change",
          "missing-object",
          "env-error",
          "max-turns",
          "timeout",
          "model-error",
          "refusal",
          "tool-call-error",
          "no-tool-use",
          "output-limit",
          "repetition-loop",
          "empty-reply",
          "context-full",
          "answer-in-reply",
          "wrong-dialect",
          "attempted-change",
          "no-verification",
          "ignored-error"
        ],
        "type": "string"
      },
      "title": "Failure Hints",
      "type": "array"
    },
    "canaries": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Canaries",
      "type": "object"
    },
    "metrics": {
      "additionalProperties": true,
      "description": "Filled in by the runner: tokens, cost, wall time, turns, tool calls.",
      "title": "Metrics",
      "type": "object"
    },
    "judge": {
      "anyOf": [
        {
          "$ref": "#/$defs/Judgement"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The task's `llm_judge` checks and the failure summary. None: the task has no judge check and no judge has run. Never changes `outcome` or `score`."
    }
  },
  "required": [
    "task_id",
    "run_id",
    "stick_version",
    "started_at",
    "graded_at",
    "outcome",
    "score",
    "checks"
  ],
  "title": "Result",
  "type": "object",
  "$id": "https://github.com/Jitter00/llm-on-a-stick/schemas/result.schema.json"
}
