{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jitter00/llm-on-a-stick/schemas/task.schema.json",
  "title": "llm-on-a-stick task",
  "description": "One benchmark task. Lives at <section>/<task-id>/task.yaml (built-in or user-provided).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "section", "title", "tier", "prompt", "checks"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "section": {
      "enum": ["lab-mgmt", "cfg-mgmt", "sot-ddi", "validation-observability", "troubleshooting"]
    },
    "title": {"type": "string", "minLength": 3},
    "tier": {"enum": ["basic", "intermediate", "advanced"]},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9.-]+$"}},
    "prompt": {"type": "string", "minLength": 10, "description": "Jinja template rendered with topology vars and canary values."},
    "topology": {"type": "string", "default": "base", "description": "Built-in topology name or path to a .clab.yml file."},
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "devices": {"type": "array", "items": {"type": "string"}},
        "services": {"type": "array", "items": {"type": "string"}},
        "backend": {"enum": ["containerlab", "cml"]},
        "kvm": {"type": "boolean"},
        "arch": {"type": "array", "items": {"enum": ["amd64", "arm64"]}}
      }
    },
    "canaries": {
      "type": "object",
      "description": "Random values seeded per run so memorised or invented answers fail.",
      "additionalProperties": {"enum": ["asn", "ipv4", "description", "hostname"]}
    },
    "setup": {"type": "string", "description": "Script (relative to the task dir) that prepares the initial state."},
    "oracle": {"type": "string", "description": "Reference solution script; `stick task validate` requires it to PASS."},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {"type": "string", "description": "Built-in check name (e.g. bgp_session) or plugin check."},
          "name": {"type": "string"},
          "params": {"type": "object"},
          "weight": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "allowed_changes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Devices/services the agent may change; anything else changing is a collateral-change failure."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turns": {"type": "integer", "minimum": 1},
        "tokens": {"type": "integer", "minimum": 1},
        "time_s": {"type": "integer", "minimum": 1}
      }
    },
    "matrix": {
      "type": "object",
      "description": "Parameterised variants: each combination becomes its own task.",
      "additionalProperties": {"type": "array", "minItems": 1}
    }
  }
}
